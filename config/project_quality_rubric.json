  "policy": {
    "forbidden_tracked_globs": [
      ".env",
      ".env.*",
      "**/__pycache__/**",
      "**/*.pyc",
      "**/*.pyo",
      ".venv/**",
      "venv/**",
      ".cache/**",
      ".tmp/**",
      ".pytest_cache/**",
      ".ruff_cache/**",
      "**/*.db",
      "**/*.sqlite",
      "**/*.sqlite3",
      "mlruns/**",
      "integrations/langflow/.langflow-data/**",
      "integrations/langgraph/.langgraph_api/**",
      "integrations/langflow/docker-compose.override.yml",
      ".claude/settings.local.json"
    ],
    "allowed_tracked_paths": [
      ".env.example",
      "integrations/langgraph/.env.example"
    ],
    "text_scan_extensions": [
      ".py",
      ".js",
      ".html",
      ".css",
      ".md",
      ".toml",
      ".yaml",
      ".yml",
      ".json",
      ".jsonl",
      ".ps1",
      ".sh",
      ".txt",
      ".example"
    ],
    "safe_private_ip_literals": [
      "10.20.30.40",
      "10.0.0.5"
    ],
    "safe_unc_hosts": [
      "host",
      "internal-host"
    ],
    "fixture_contracts": [
      {
        "path": "data/evaluation/document_chatbot_golden.jsonl",
        "tier": "golden",
        "review_status": "validated",
        "minimum_cases": 15,
        "reviewed_on_required": true
      },
      {
        "path": "data/evaluation/document_chatbot_candidates.jsonl",
        "tier": "candidate",
        "review_status": "candidate",
        "minimum_cases": 25,
        "reviewed_on_required": false
      }
    ],
    "runtime": {
      "project_name": "smb-finder",
      "python_requirement": ">=3.11",
      "python_ci_version": "3.11",
      "ruff_line_length": 120,
      "ruff_src": [
        "src",
        "tests"
      ],
      "pytest_marker": "integration",
      "required_dependencies": [
        "pydantic",
        "smbprotocol"
      ],
      "lock_file": "uv.lock"
    },
    "architecture_markers": {
      "index_first": {
        "src/smb_finder/finder.py": [
          "FolderIndex",
          "self._index.search",
          "source=\"index\""
        ],
        "src/smb_finder/content_search.py": [
          "ContentIndex",
          "self._index.search",
          "elapsed_ms"
        ],
        "src/smb_finder/index.py": [
          "인메모리",
          "def search"
        ],
        "src/smb_finder/api.py": [
          "load_or_build",
          "run_in_threadpool(finder.find"
        ]
      },
      "timeout_elapsed": {
        "src/smb_finder/finder.py": [
          "time.perf_counter",
          "elapsed_ms",
          "over_budget"
        ],
        "src/smb_finder/content_search.py": [
          "time.perf_counter",
          "elapsed_ms",
          "over_budget"
        ],
        "src/smb_finder/rag_search.py": [
          "timeout=",
          "statement_timeout",
          "elapsed_ms"
        ],
        "src/smb_finder/tooling/executor.py": [
          "FutureTimeoutError",
          "timeout_ms",
          "elapsed_ms"
        ]
      },
      "read_only": {
        "src/smb_finder/smb_client.py": [
          "mode=\"rb\"",
          "register_session",
          "reset_connection_cache"
        ],
        "src/smb_finder/rag_search.py": [
          "default_transaction_read_only=on",
          "statement_timeout"
        ],
        "src/smb_finder/tooling/catalog.py": [
          "permission: Literal[\"read\"]",
          "read_only: bool = True",
          "destructive: bool = False"
        ]
      },
      "api_tool_contracts": {
        "src/smb_finder/api.py": [
          "response_model=FindResponse",
          "response_model=ContentSearchResponse",
          "McpExactRoute"
        ],
        "src/smb_finder/tooling/contracts.py": [
          "class FindFolderInput(BaseModel)",
          "class FindFolderOutput(BaseModel)",
          "class SearchContentInput(BaseModel)",
          "class SearchContentOutput(BaseModel)"
        ],
        "src/smb_finder/tooling/catalog.py": [
          "SEARCH_TOOL_SPECS",
          "allowed_surfaces",
          "MappingProxyType"
        ],
        "src/smb_finder/rag_search.py": [
          "rag_similarity_cutoff",
          "rejected_count",
          "no_answer=not hits"
        ],
        "src/smb_finder/playground/models.py": [
          "class RagGroundingMetadata(BaseModel)",
          "rag_grounding: RagGroundingMetadata | None"
        ],
        "src/smb_finder/playground/agent.py": [
          "rag_synthesis_evidence_chars",
          "rag_synthesis_max_tokens",
          "def _rag_synthesis_evidence",
          "def _llm_http_client"
        ],
        "src/smb_finder/playground/api.py": [
          "shared_agent",
          "shared_agent_lifespan"
        ]
      },
      "observability": {
        "src/smb_finder/tooling/executor.py": [
          "elapsed_ms",
          "over_budget",
          "_audit"
        ],
        "src/smb_finder/api.py": [
          "ApiErrorResponse",
          "internal_error",
          "type(exc).__name__"
        ]
      }
    },
    "forbidden_smb_mutation_patterns": [
      "smbclient.remove(",
      "smbclient.rename(",
      "smbclient.mkdir(",
      "smbclient.rmdir(",
      "smbclient.link(",
