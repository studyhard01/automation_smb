  "policy": {
    "forbidden_tracked_globs": [
      ".env", ".env.*", "**/__pycache__/**", "**/*.pyc", "**/*.pyo", ".venv/**", "venv/**",
      ".cache/**", ".tmp/**", ".pytest_cache/**", ".ruff_cache/**", "**/*.db", "**/*.sqlite", "**/*.sqlite3",
      "frontend/node_modules/**", ".claude/settings.local.json"
    ],
    "allowed_tracked_paths": [".env.example"],
    "text_scan_extensions": [".py", ".ts", ".vue", ".js", ".html", ".css", ".md", ".toml", ".yaml", ".yml", ".json", ".ps1", ".sh", ".txt", ".example"],
    "safe_private_ip_literals": ["10.20.30.40", "10.0.0.5"],
    "safe_unc_hosts": ["host", "internal-host"],
    "fixture_contracts": [],
    "runtime": {
      "project_name": "automation-smb",
      "python_requirement": ">=3.11",
      "python_ci_version": "3.11",
      "ruff_line_length": 120,
      "ruff_src": ["backend/src", "backend/tests"],
      "pytest_marker": "integration",
      "required_dependencies": ["pydantic", "httpx", "psycopg", "boto3", "neo4j"],
      "lock_file": "uv.lock"
    },
    "architecture_markers": {
      "index_first": {
        "backend/src/smb_finder/llmops_search.py": ["WITH candidates AS", "document_chunks", "elapsed_ms"],
        "backend/src/smb_finder/llmops_retrieval.py": ["WITH selected(doc_id", "rrf_score", "candidate_count"]
      },
      "timeout_elapsed": {
        "backend/src/smb_finder/llmops_search.py": ["statement_timeout", "time.perf_counter", "elapsed_ms"],
        "backend/src/smb_finder/llmops_retrieval.py": ["llmops_embedding_timeout_ms", "statement_timeout", "elapsed_ms"],
        "backend/src/smb_finder/playground/document_chat.py": ["llm_timeout_ms", "playground_agent_budget_ms", "elapsed_ms"]
      },
      "read_only": {
        "backend/src/smb_finder/llmops_search.py": ["default_transaction_read_only=on", "application_name"],
        "backend/src/smb_finder/llmops_retrieval.py": ["default_transaction_read_only=on", "statement_timeout"],
        "backend/src/smb_finder/llmops_artifacts.py": ["default_transaction_read_only=on", "head_object", "get_object"],
        "backend/src/smb_finder/llmops_graph.py": ["MATCH (d:Document", "default_access_mode=READ_ACCESS"]
      },
      "api_tool_contracts": {
        "backend/src/smb_finder/playground/document_models.py": ["class ChatRequest(BaseModel)", "selected_files", "class ChatResponse(BaseModel)"],
        "backend/src/smb_finder/playground/document_api.py": ["response_model=DocumentSearchResponse", "validate_active_selections", "response_model=ChatResponse"],
        "backend/src/smb_finder/playground/document_chat.py": ["selections =", "rag_insufficient_evidence", "citations"]
      },
      "observability": {
        "backend/src/smb_finder/api.py": ["ApiErrorResponse", "internal_error", "type(exc).__name__"],
        "backend/src/smb_finder/llmops_search.py": ["time.perf_counter", "over_budget", "_logger.warning"],
        "backend/src/smb_finder/playground/document_api.py": ["Document chat completed", "elapsed_ms", "error_code"]
      }
    },
    "forbidden_smb_mutation_patterns": [
      "smbclient.remove(", "smbclient.rename(", "smbclient.mkdir(", "smbclient.rmdir(", "smbclient.link(",
      "smbclient.symlink(", "mode=\"wb\"", "mode=\"ab\"", "mode=\"w\"", "mode=\"a\""
    ],
    "canonical_documents": {
      "README.md": {
        "required_tokens": ["자연어로 파일 검색", "PostgreSQL", "MinIO", "Neo4j", "read-only", "backend/src/smb_finder/playground/document_chat.py", "scripts/evaluate_quality.py"],
        "forbidden_tokens": ["Langflow endpoint", "ToolCatalog"]
