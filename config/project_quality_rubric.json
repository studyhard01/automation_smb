        {"id": "sensitive_value_hygiene", "title": "자격증명·내부 주소 비노출", "points": 10, "hard_gate": true, "check": "sensitive_values"},
        {"id": "read_only_boundary", "title": "저장소 읽기 전용", "points": 8, "hard_gate": true, "check": "read_only_architecture"}
      ]
    },
    {
      "id": "functionality_regression",
      "title": "기능·회귀",
      "weight": 20,
      "criteria": [
        {"id": "pytest_non_integration", "title": "활성 Backend pytest", "points": 20, "hard_gate": true, "check": "pytest"}
      ]
    },
    {
      "id": "latency_performance",
      "title": "지연·성능",
      "weight": 20,
      "criteria": [
        {"id": "index_first_fast_path", "title": "DB 검색 fast path", "points": 4, "hard_gate": true, "check": "index_first_architecture"},
        {"id": "timeout_elapsed_contract", "title": "timeout·elapsed_ms 계약", "points": 4, "hard_gate": true, "check": "timeout_elapsed_architecture"},
