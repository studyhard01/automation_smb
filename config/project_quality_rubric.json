        {"id": "python_runtime_conventions", "title": "Python·uv·src 규약", "points": 3, "hard_gate": true, "check": "runtime_conventions"},
        {"id": "api_contracts", "title": "Pydantic 문서 API 계약", "points": 4, "hard_gate": true, "check": "api_tool_contracts"},
