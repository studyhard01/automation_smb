# ── 이 파일을 .env로 복사한 뒤 값을 채운다 (.env는 .gitignore 대상) ──
# 이 외피는 사내 smb-finder + 온프레미스 LLM만 호출한다. 외부 호스트로 바꾸지 말 것.

# ── 사내 smb-finder 서비스 (진짜 검색 로직은 전부 여기) ───────
SMB_FINDER_URL=http://localhost:8010   # smb-finder base URL. 사내망만.
TOOL_TIMEOUT_MS=1500                    # smb-finder 호출 timeout(ms), 초과 시 빈 결과로 즉시 반환
FIND_LIMIT=5                            # 폴더 찾기 기본 반환 수
CONTENT_LIMIT=10                        # 내용 검색 기본 반환 수

# ── 온프레미스 LLM (OpenAI 호환) ─────────────────────────────
# smb_finder의 .env와 같은 키. base_url은 반드시 사내/로컬. 외부 API(OpenAI 등) 금지.
LLM_BASE_URL=http://localhost:8080/v1   # 로컬 llama.cpp 등 (OpenAI 호환 엔드포인트, 보통 .../v1)
LLM_MODEL=local-model                   # 모델명 (서버 설정에 맞게)
LLM_API_KEY=sk-no-key                   # llama.cpp 등은 임의값 가능 (실제 키면 .env에만)
LLM_TIMEOUT_MS=20000                    # 에이전트 LLM 호출 timeout(ms)
LLM_TEMPERATURE=0.0

# ── ⚠️ 보안: LangSmith 트레이싱 끄기 (환자/검사 데이터 클라우드 업로드 방지) ──
# 켜면 노드 입출력(폴더 경로·본문 스니펫)이 LangSmith 클라우드로 전송된다 — CLAUDE.md 위반.
# 켜야 하면 반드시 사내 self-hosted LangSmith(LANGSMITH_ENDPOINT)만 사용할 것.
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false
