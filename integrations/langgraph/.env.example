# Copy this file to .env. Keep this file ASCII-only because langgraph dev
# may parse it with the Windows default encoding.

# Local smb-finder service.
SMB_FINDER_URL=http://localhost:8010
TOOL_TIMEOUT_MS=1500
FIND_LIMIT=5
CONTENT_LIMIT=10
ADMIN_API_TOKEN=
CONTENT_INDEX_POLL_INTERVAL_MS=1000
CONTENT_INDEX_POLL_TIMEOUT_MS=5000

# On-prem/local OpenAI-compatible LLM. Do not point this to external APIs.
LLM_BASE_URL=http://localhost:8080/v1
LLM_MODEL=local-model
LLM_API_KEY=local-no-key
LLM_TIMEOUT_MS=20000
LLM_TEMPERATURE=0.0

# LangSmith tracing is opt-in. Keep off for real patient/test data.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=automation-smb-langgraph
LANGSMITH_ENDPOINT=
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true
LANGCHAIN_TRACING_V2=false
