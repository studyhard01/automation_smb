# ── 이 파일을 .env로 복사한 뒤 실제 값을 채운다 (.env는 .gitignore 대상) ──
# 실제 운영 값은 ../automation/.env 에 있다. 내부 IP·자격증명은 여기(예시)에 적지 않는다.

# ── SMB 공유 폴더 ────────────────────────────────────────────
SMB_HOST=                 # 예: 192.168.x.x  (NAS/파일서버 IP)
SMB_SHARE_NAME=           # 예: ai공유폴더
SMB_USERNAME=
SMB_PASSWORD=

# ── 폴더 인덱스 (지연 최소화의 핵심) ──────────────────────────
SMB_INDEX_CACHE_PATH=.cache/folder.index.json   # 인덱스 캐시 경로
SMB_INDEX_MAX_DEPTH=4                            # 인덱싱 최대 깊이 (0=무제한, 깊을수록 빌드 급격히 느려짐)
SMB_INDEX_BUILD_BUDGET_SEC=60                    # 인덱스 빌드 시간 상한(초), 초과 시 부분 인덱스 저장
SMB_INDEX_EXCLUDE=#recycle,@eaDir,.DS_Store      # 인덱싱 제외 폴더명(쉼표 구분, 휴지통 등 노이즈)
SMB_INDEX_REFRESH_SEC=900                        # 백그라운드 재인덱싱 주기(초), 0=비활성

# ── 시간 예산 (ms) ───────────────────────────────────────────
FIND_BUDGET_MS=1500       # 이 시간을 넘기면 부분 결과라도 즉시 반환
FIND_DEFAULT_LIMIT=5      # 기본 반환 폴더 수

# ── 내용 검색 인덱스 (FTS5, 파일 본문) ───────────────────────
# ⚠️ content.fts.db 에는 환자/검사 본문이 들어간다 — 로컬에만 두고 외부 공유·커밋 금지(.cache/ 는 .gitignore).
CONTENT_INDEX_DB_PATH=.cache/content.fts.db          # 내용 인덱스 SQLite 경로
CONTENT_INDEX_MAX_DEPTH=0                             # 내용 인덱싱 최대 깊이 (0=무제한)
CONTENT_INDEX_BUILD_BUDGET_SEC=300                   # 빌드 시간 상한(초). 초과 시 부분 인덱스로 마감
CONTENT_MAX_FILE_MB=20                                # 이보다 큰 파일은 건너뜀(추출 비용·지연 방지)
CONTENT_MAX_CHARS_PER_FILE=200000                    # 파일당 저장 본문 상한(글자)
CONTENT_EXTENSIONS=.txt,.csv,.tsv,.md,.log,.json,.xml,.htm,.html,.docx,.xlsx,.pptx,.pdf  # 대상 확장자
CONTENT_SEARCH_BUDGET_MS=1500                        # 내용 검색 시간 예산(ms)
CONTENT_DEFAULT_LIMIT=10                             # 기본 반환 파일 수

# ── 관리자 API (무거운 인덱싱 작업) ─────────────────────────
# 비어 있으면 /admin/* 엔드포인트는 비활성화된다. 운영에서는 충분히 긴 랜덤 값으로 설정한다.
ADMIN_API_TOKEN=
CONTENT_INDEX_JOB_RETENTION=50                       # 메모리에 보관할 최근 내용 인덱싱 job 수
SMB_ALLOWED_HOSTS=                                   # host override 허용 목록. 비우면 SMB_HOST만 허용
SMB_ALLOWED_SHARES=                                  # share_name override 허용 목록. 비우면 SMB_SHARE_NAME만 허용

# ── L2 의도 해석용 LLM (OpenAI 호환, 온프레미스) ──────────────
# 기본은 규칙 기반 fast-path. 아래를 켜면 모호한 질의만 LLM으로 보낸다.
LLM_INTENT_ENABLED=false
LLM_BASE_URL=http://localhost:8080   # 로컬 llama.cpp/Ollama/LM Studio (OpenAI 호환). Ollama 예: http://127.0.0.1:11434/v1
LLM_MODEL=                           # Playground 화면에서도 임시 입력 가능. 예: qwen2.5-coder:7b
LLM_API_KEY=                          # llama.cpp는 빈 값 가능
LLM_TIMEOUT_MS=800                    # fast-path 의도 해석 timeout. Playground 검증/채팅은 로컬 모델 속도에 맞춰 더 크게 실행 가능
PLAYGROUND_AGENT_MAX_STEPS=3          # Playground agent 최대 판단 단계 수
PLAYGROUND_AGENT_MAX_TOOL_CALLS=2     # Playground agent 요청당 최대 tool 호출 수
PLAYGROUND_AGENT_BUDGET_MS=10000      # Playground agent 전체 시간 예산(ms)
PLAYGROUND_AGENT_CONTEXT_MESSAGES=6   # LLM에 전달할 최근 대화 수
PLAYGROUND_AGENT_RESULT_CHARS=2000    # LLM observation에 전달할 tool 결과 최대 글자 수
PLAYGROUND_DEBUG_RAW_LLM=false        # 테스트용 raw LLM debug 반환 허용. 운영/공용 배포에서는 false 유지
PLAYGROUND_DEBUG_PREVIEW_CHARS=4000   # raw LLM debug preview 최대 글자 수

# ── Langflow 워크플로우 자동 생성기 ─────────────────────────
# 기본은 규칙 기반 + 로컬 LLM(auto). OpenAI는 아래 allow 플래그와 OPENAI_API_KEY가 둘 다 있어야 사용한다.
LANGFLOW_COMPOSER_LOCAL_BASE_URL=http://localhost:11434/v1
LANGFLOW_COMPOSER_LOCAL_MODEL=
LANGFLOW_COMPOSER_LLM_TIMEOUT_MS=1200
LANGFLOW_COMPOSER_ALLOW_OPENAI=false
LANGFLOW_COMPOSER_OPENAI_MODEL=gpt-4.1-mini
LANGFLOW_COMPOSER_ALLOWED_HOSTS=                    # 사내 DNS 예외가 필요할 때만 쉼표로 추가
LANGFLOW_AUTO_LOGIN=true                            # 로컬 개발 편의. 운영/공용 배포에서는 인증 정책에 맞게 조정
LANGFLOW_ACCESS_TOKEN_EXPIRE_SECONDS=43200          # 로컬 개발 중 빈 Untitled Flow를 줄이기 위한 세션 시간(12h)
LANGFLOW_REFRESH_TOKEN_EXPIRE_SECONDS=604800        # 기본 7일
# OPENAI_API_KEY는 실제 사용할 때만 .env에 넣고 저장소에 커밋하지 않는다.
LANGFLOW_API_KEY=                                   # 인증이 켜진 Langflow에 등록할 때만 로컬 .env/override에서 설정
