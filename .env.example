# 실제 값은 .env에만 저장하고 커밋하지 않습니다.

# PostgreSQL / llmops schema (read-only account)
LLMOPS_DB_ENABLED=true
LLMOPS_DB_HOST=
DEV_SERVER=
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_USER=
POSTGRES_PASSWORD=
LLMOPS_POSTGRES_DB=
LLMOPS_POSTGRES_SCHEMA=llmops
SKIP_POSTGRES=false
LLMOPS_DB_CONNECT_TIMEOUT_MS=1000
LLMOPS_DB_QUERY_TIMEOUT_MS=1500
LLMOPS_FILE_SEARCH_LIMIT=10
LLMOPS_FILE_SEARCH_MAX_LIMIT=20
LLMOPS_FILE_SEARCH_BUDGET_MS=8000
LLMOPS_FILE_SEARCH_SOURCE_LIMIT=30
LLMOPS_FILE_SEARCH_LLM_ENABLED=true
LLMOPS_FILE_SEARCH_LLM_MODEL=
LLMOPS_FILE_SEARCH_LLM_TIMEOUT_MS=6000
LLMOPS_FILE_SEARCH_LLM_MAX_TERMS=8

# 로그인·사용자 권한 PostgreSQL (위 read-only 계정과 분리된 schema 생성/쓰기 계정)
# HOST와 DB 이름을 비우면 기존 PostgreSQL server 주소/DB 이름만 재사용합니다. 자격증명은 fallback하지 않습니다.
AUTH_DB_ENABLED=true
AUTH_DB_HOST=
AUTH_DB_PORT=5432
AUTH_DB_NAME=
AUTH_DB_USER=
AUTH_DB_PASSWORD=
# 합성 데이터 로컬 DB 계정에 auth schema 쓰기 권한을 별도로 확인한 경우에만 true
AUTH_DB_USE_LLMOPS_CREDENTIALS=false
AUTH_DB_SCHEMA=auth
AUTH_DB_CONNECT_TIMEOUT_MS=1000
AUTH_DB_QUERY_TIMEOUT_MS=2000
AUTH_SESSION_COOKIE_NAME=automation_smb_session
AUTH_SESSION_TTL_SECONDS=28800
AUTH_COOKIE_SECURE=false

# 최초 기동에서만 admin이 없을 때 생성합니다. 성공 후 AUTH_INITIAL_ADMIN_PASSWORD는 .env에서 지웁니다.
AUTH_INITIAL_ADMIN_USERNAME=admin
AUTH_INITIAL_ADMIN_PASSWORD=
AUTH_INITIAL_ADMIN_EMAIL=
AUTH_INITIAL_ADMIN_DISPLAY_NAME=최고 관리자

# SeeLIS 계정 로그인 (API key·실제 URL은 server-side .env/Secret에만 입력)
SEELIS_LOGIN_TOKEN_API_URL=
SEELIS_LOGIN_TOKEN_API_URL_KEY=x-api-key
SEELIS_LOGIN_TOKEN_API_URL_VALUE=
SEELIS_LOGIN_TOKEN_API_TIMEOUT_MS=30000
SEELIS_LOGIN_KEYCLOAK_URL=
SEELIS_LOGIN_KEYCLOAK_URL_KEY=Authorization
SEELIS_LOGIN_KEYCLOAK_URL_VALUE=Bearer {token}
SEELIS_LOGIN_KEYCLOAK_TIMEOUT_MS=10000

# 선택 문서 Hybrid/RRF 검색 + 온프레미스 Ollama
LLMOPS_RETRIEVAL_TOP_K=6
LLMOPS_RETRIEVAL_CANDIDATE_K=40
LLMOPS_RETRIEVAL_SCORE_CUTOFF=0.01
LLMOPS_CHUNK_MAX_CHARS=1600
LLMOPS_EMBEDDING_TIMEOUT_MS=2000
OLLAMA_BASE_URL=
EMBEDDING_MODEL=nomic-embed-text-v2-moe
EMBEDDING_DIM=768
EMBEDDING_QUERY_PREFIX="search_query: "
LLMOPS_CHAT_MODEL=qwen3:30b-a3b
LLM_TIMEOUT_MS=10000
RAG_SYNTHESIS_EVIDENCE_CHARS=1800
RAG_SYNTHESIS_MAX_TOKENS=500
PLAYGROUND_AGENT_BUDGET_MS=10000
PLAYGROUND_AGENT_CONTEXT_MESSAGES=6

# MinIO Artifact (read-only access key)
MINIO_ENDPOINT=
MINIO_SECURE=false
LLMOPS_MINIO_BUCKET=
LLMOPS_MINIO_ACCESS_KEY=
LLMOPS_MINIO_SECRET_KEY=
LLMOPS_MINIO_CONNECT_TIMEOUT_MS=500
LLMOPS_MINIO_READ_TIMEOUT_MS=1000
LLMOPS_ARTIFACT_MAX_BYTES=2097152

# Neo4j version graph (read-only account)
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=
LLMOPS_NEO4J_DATABASE=
LLMOPS_NEO4J_MODE=graph_space
LLMOPS_GRAPH_SPACE=llmops_document_bot
LLMOPS_GRAPH_ENABLED=true
LLMOPS_NEO4J_TIMEOUT_MS=1000

# SMB 파일 첨부 (명시적으로 true로 바꾸기 전에는 쓰기가 비활성화됩니다.)
SMB_UPLOAD_ENABLED=false
SMB_HOST=
SMB_SHARE_NAME=
SMB_USERNAME=
SMB_PASSWORD=
SMB_UPLOAD_DEFAULT_RELATIVE_DIRECTORY=
SMB_UPLOAD_RUNTIME_SETTINGS_PATH=.runtime/playground_settings.json
SMB_UPLOAD_MAX_SIZE_BYTES=26214400
SMB_UPLOAD_ALLOWED_EXTENSIONS=.pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.txt,.csv
SMB_UPLOAD_TIMEOUT_MS=15000
SMB_UPLOAD_MAX_CONCURRENCY=2
