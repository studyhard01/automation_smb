      "value_type": "number",
      "unit": "°C",
      "minimum": 18.0,
      "maximum": 24.0,
      "warning_margin": 0.5,
      "criterion": "18.0–24.0 °C",
      "evidence": "SYN-SOP-001 §2.1"
    },
    {
      "id": "SYN-QC-YIELD",
      "title": "Nova recovery rate",
      "aliases": ["Nova recovery", "회수율", "노바 회수율"],
      "value_type": "number",
      "unit": "%",
      "minimum": 80.0,
      "maximum": 120.0,
      "warning_margin": 2.0,
      "criterion": "80.0–120.0 %",
      "evidence": "SYN-SOP-001 §2.2"
    },
    {
      "id": "SYN-QC-STATUS",
      "title": "Orion self-check",
      "aliases": ["Orion status", "자체 점검", "오리온 상태"],
      "value_type": "text",
      "unit": "",
      "accepted_values": ["PASS", "OK", "정상"],
      "criterion": "상태값 PASS, OK 또는 정상",
      "evidence": "SYN-SOP-001 §2.3"
    }
  ]
}
