{
  "dataset": "synthetic-qc-sop-v1",
  "notice": "기능 검증 전용 합성 기준이며 실제 검사실 SOP가 아닙니다.",
  "rules": [
    {
      "id": "SYN-QC-TEMP",
      "title": "Aurora chamber temperature",
